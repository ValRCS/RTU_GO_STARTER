{
  "name": "RTU Go Starter",
  "image": "mcr.microsoft.com/devcontainers/go:2-1.27",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go"
      ],
      "settings": {
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.formatOnSave": true
        },
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true
      }
    }
  },
  "postCreateCommand": "go version && go env GOMOD GOPATH && go mod download"
}
